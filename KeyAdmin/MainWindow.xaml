<Window x:Class="KeyAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyAdmin Pro" Height="750" Width="600"
        WindowStartupLocation="CenterScreen" Background="#F4F4F4" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="15" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Création de Licence" FontSize="20" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,15"/>
                <TextBlock Text="Code Machine (HWID) :"/>
                <TextBox Name="TxtHwid" Height="25" Margin="0,5,0,10"/>
                <TextBlock Text="Entreprise :"/>
                <TextBox Name="TxtEntreprise" Height="25" Margin="0,5,0,10" />
                <TextBlock Text="Type de Licence :"/>
                <ComboBox Name="CboRole" Height="25" Margin="0,5,0,10">
                    <ComboBoxItem Content="SuperAdmin" IsSelected="True"/>
                    <ComboBoxItem Content="EGL"/>
                    <ComboBoxItem Content="Particulier"/>
                    <ComboBoxItem Content="Profesionel"/>
                </ComboBox>
                <TextBlock Text="Date d'expiration :"/>
                <DatePicker Name="DateExpiration" Height="25" Margin="0,5,0,15"/>
                <Button Content="⚙️ GÉNÉRER LA CLÉ" Height="40" Background="#007ACC" Foreground="White" FontWeight="Bold" Click="BtnGenerer_Click"/>
                <TextBox Name="TxtCleResultat" Height="50" Margin="0,15,0,0" IsReadOnly="True" Background="#E8F4F8" Foreground="#007ACC" FontWeight="Bold" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" Padding="15" Margin="0,15,0,0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Historique Local &amp; Révocation" FontSize="16" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                    <Button Content="🔄 Rafraîchir" HorizontalAlignment="Right" Width="100" Height="30" Background="#4CAF50" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnRafraichir_Click"/>
                </Grid>

                <DataGrid Name="GridHistorique" AutoGenerateColumns="False" IsReadOnly="True" Height="180">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding DateGen}" Width="80"/>
                        <DataGridTextColumn Header="Client / Entreprise" Binding="{Binding AffichageClient}" Width="*"/>
                        <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="80" FontWeight="Bold"/>
                        <DataGridTemplateColumn Header="Action">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Révoquer" Background="#D32F2F" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnRevoquer_Click" IsEnabled="{Binding PeutRevoquer}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</Window>