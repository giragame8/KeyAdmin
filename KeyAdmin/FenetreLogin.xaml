<Window x:Class="KeyAdmin.FenetreLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyAdmin - Connexion" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F4F4F4" FontFamily="Segoe UI">

    <Border Background="White" Margin="20" Padding="20" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TxtTitre" Text="Connexion Sécurisée" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Email Autorisé :" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtEmail" Height="25" Margin="0,5,0,10" Background="#F9F9F9"/>

            <TextBlock Text="Mot de passe local :" FontWeight="SemiBold"/>
            <PasswordBox x:Name="TxtMotDePasse" Height="25" Margin="0,5,0,10" Background="#F9F9F9"/>

            <!-- ZONE CONFIGURATION INITIALE (Cachée après le premier lancement) -->
            <StackPanel x:Name="PanelConfiguration" Visibility="Collapsed">
                <TextBlock Text="--- Configuration de votre Logiciel ---" HorizontalAlignment="Center" Foreground="#888" Margin="0,10,0,10"/>

                <TextBlock Text="Votre Lien Google Apps Script :" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtScriptUrl" Height="25" Margin="0,5,0,10" Background="#F9F9F9"/>

                <TextBlock Text="Votre Clé Secrète de Chiffrement :" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtCleSecrete" Height="25" Margin="0,5,0,10" Background="#F9F9F9"/>
            </StackPanel>

            <Button x:Name="BtnValider" Content="Déverrouiller" Height="40" Margin="0,20,0,0" Background="#34495E" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnValider_Click"/>
        </StackPanel>
    </Border>
</Window>