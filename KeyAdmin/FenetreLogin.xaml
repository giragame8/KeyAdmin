<Window x:Class="KeyAdmin.FenetreLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyAdmin - Connexion" Height="380" Width="350"
        WindowStartupLocation="CenterScreen" Background="White" FontFamily="Segoe UI">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Name="TxtTitre" Text="Connexion KeyAdmin" FontSize="18" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <TextBlock Text="Adresse Email Administrateur :" FontWeight="SemiBold"/>
        <TextBox Name="TxtEmail" Height="25" Margin="0,5,0,15" Background="#F0F0F0"/>

        <TextBlock Text="Mot de passe local (Lié à ce PC) :" FontWeight="SemiBold"/>
        <PasswordBox Name="TxtMotDePasse" Height="25" Margin="0,5,0,20" Background="#F0F0F0"/>

        <Button Name="BtnValider" Content="Déverrouiller" Height="40" Background="#007ACC" Foreground="White" FontWeight="Bold" Click="BtnValider_Click" BorderThickness="0" Cursor="Hand"/>
    </StackPanel>
</Window>